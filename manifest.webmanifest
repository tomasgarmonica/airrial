{
  "name": "Airrial",
  "short_name": "Airrial",
  "description": "Cifrados de canciones con banda de acompañamiento",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111318",
  "theme_color": "#111318",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "recibir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivo",
          "accept": [
            "text/html",
            ".html",
            ".htm",
            "text/plain",
            ".txt",
            "application/json",
            ".json"
          ]
        }
      ]
    }
  }
}
